# Переменные для сборки (build.sh). Настоящие значения в репозиторий не попадают:
# задайте их в окружении или в локальном файле .env (он закрыт .gitignore).
# Пароль от ключа подписи «Смета PRO»
SMETA_KEYSTORE_PASSWORD=
# Путь к файлу ключа подписи (сам keystore в репозиторий не кладётся)
KEYSTORE_PATH=
